{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@openpay/core": ["../openpay-sdk/packages/core/src/index.ts"],
      "@openpay/react": ["../openpay-sdk/packages/react/src/index.ts"],
      "@openpay/provider-stripe": ["../openpay-sdk/packages/provider-stripe/src/index.ts"],
      "@openpay/provider-mock": ["../openpay-sdk/packages/provider-mock/src/index.ts"],
      "@openpay/webhooks": ["../openpay-sdk/packages/webhooks/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
