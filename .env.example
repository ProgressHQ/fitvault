# Database
DATABASE_URL=postgres://app:app@localhost:5432/fitvault_db?sslmode=disable

# CloudFront CDN (optional — placeholder URLs returned when not configured)
CLOUDFRONT_BASE_URL=https://cdn.example.com
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# S3 (optional — required for contributor upload pipeline)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=fitvault-videos

# Payment (OpenPay SDK provider)
# Leave unset to use MockProvider (dev/test). Set both to use StripeProvider.
# Before activating Stripe, run: pnpm add stripe
# Then uncomment the implementation in ../openpay-sdk/packages/provider-stripe/src/stripe-provider.ts
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# FitVault service base URL (used to construct checkout return URLs)
FITVAULT_BASE_URL=http://localhost:3002
