{
  "name": "ppv-exercise-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build --webpack",
    "start": "next start --port 3002",
    "typecheck": "tsc --noEmit",
    "migrate": "migrate -path db/migrations -database \"$DATABASE_URL\" up",
    "migrate:down": "migrate -path db/migrations -database \"$DATABASE_URL\" down",
    "seed": "npx tsx scripts/seed.ts"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "pg": "^8.13.0",
    "uuid": "^11.0.3",
    "@aws-sdk/client-s3": "^3.806.0",
    "@aws-sdk/s3-request-presigner": "^3.806.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
